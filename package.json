{
  "name": "takecraft",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "pnpm@10.28.2",
  "bin": {
    "takecraft": "bin/takecraft.mjs"
  },
  "scripts": {
    "takecraft": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-metadata.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:browser": "vitest run tests/browser",
    "test:e2e": "vitest run tests/e2e",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.3.1",
    "esbuild": "0.28.2",
    "fontkit": "2.0.4",
    "motion": "14.6.0",
    "playwright": "1.64.1",
    "sharp": "0.34.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.8",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "description": "Local product videos for coding agents: reusable motion, themes, rendering and checks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlonGuo/takecraft.git"
  },
  "homepage": "https://github.com/PlonGuo/takecraft",
  "bugs": {
    "url": "https://github.com/PlonGuo/takecraft/issues"
  },
  "files": [
    "bin/",
    "dist/",
    "recipes/",
    "skills/takecraft/",
    "examples/product-launch-v2/brief.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
