{
  "name": "takecraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "packageManager": "pnpm@10.28.2",
  "bin": { "takecraft": "dist/cli/index.js" },
  "scripts": {
    "takecraft": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:browser": "vitest run tests/browser",
    "test:e2e": "vitest run tests/e2e"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.0",
    "esbuild": "^0.28.0",
    "fontkit": "^2.0.4",
    "playwright": "^1.56.0",
    "sharp": "^0.34.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.8",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "sharp"] }
}
